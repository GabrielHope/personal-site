---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.slug },
  }));
}

const { slug } = Astro.params;
const post = await getCollection('blog').then(posts =>
  posts.find(p => p.slug === slug)
);

if (!post) {
  return Astro.redirect('/404');
}

const { Content } = await post.render();
---
<BaseLayout title={post.data.title}>
  <main class="container">
    <article class="page prose">
      <header class="mb-10">
        {post.data.heroImage && (
          <Image src={post.data.heroImage} alt="Hero image" width={1200} height={800} />
        )}
        <h1 class="text-4xl font-bold mb-3">{post.data.title}</h1>
        {post.data.pubDate ? (
          <time datetime={post.data.pubDate.toISOString()} class="text-sm text-muted">
            {post.data.pubDate.toLocaleDateString('en-US', { dateStyle: 'long' })}
          </time>
        ) : (
          <span class="text-muted text-sm">Date not set</span>
        )}
        {post.data.description && (
          <p class="mt-4 text-lg text-muted leading-relaxed">
            {post.data.description}
          </p>
        )}
      </header>
      <div class="prose prose-invert max-w-none">
        <Content />
      </div>
    </article>
  </main>
</BaseLayout>

<style>
.prose :global(ol) {
  list-style: decimal;
  padding-left: 1.5rem;
  margin-bottom: 1.25rem;
}
.prose :global(ol li) {
  margin-bottom: 0.5rem;
  padding-left: 0.25rem;
}
.prose :global(ul) {
  list-style: disc;
  padding-left: 1.5rem;
  margin-bottom: 1.25rem;
}
.prose :global(ul li) {
  margin-bottom: 0.5rem;
  padding-left: 0.25rem;
}

.prose :global(img) {
  width: 100%;
  height: auto;
  max-width: 100%;
  display: block;
  border-radius: 6px;
  margin: 1.5rem 0;
}
</style>
