---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

// Get all non-draft posts, sorted newest first
const posts = (await getCollection('blog'))
  .filter(post => !post.data.draft)
  .sort((a, b) => {
    const dateA = a.data.pubDate ? a.data.pubDate.valueOf() : 0;
    const dateB = b.data.pubDate ? b.data.pubDate.valueOf() : 0;
    return dateB - dateA;
  });
---

<BaseLayout title="Posts">
  <main class="container">
    <header class="hero text-center">
      <h1>Posts</h1>
      <p class="text-muted mt-2">
        Notes, experiments, and things I'm learning slowly.
      </p>
    </header>

    {posts.length > 0 ? (
      <ul class="writing-list mt-10">
        {posts.map(post => (
          <li class="writing-item">
            <a href={`/posts/${post.id}`}>
              {post.data.title}
            </a>

            {post.data.pubDate ? (
              <time datetime={post.data.pubDate.toISOString()}>
                {post.data.pubDate.toLocaleDateString('en-US', {
                  month: 'short',
                  year: 'numeric'
                })}
              </time>
            ) : (
              <span class="text-muted">No date</span>
            )}
          </li>
        ))}
      </ul>
    ) : (
      <div class="text-center py-12 text-muted">
        <p>No posts yet… first one coming soon.</p>
      </div>
    )}
  </main>
</BaseLayout>
