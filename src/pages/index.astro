---
import { Image } from 'astro:assets';
import profile from '../assets/profile.png'; 
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allPosts = (await getCollection('blog'))
  .filter(post => !post.data.draft);

const recentPosts = allPosts
  .sort((a, b) => {
    const dateA = a.data.pubDate ? a.data.pubDate.valueOf() : 0;
    const dateB = b.data.pubDate ? b.data.pubDate.valueOf() : 0;
    return dateB - dateA;
  })
  .slice(0, 5);
---

<BaseLayout title="Gabriel's Webpage">
  <main>

    <section class="hero">
      <Image
        src={profile}
        alt="Gabriel"
        class="profile-img"
        width={160}
        height={160}
        loading="eager"
        fetchpriority="high"
      />
      <h1>Gabriel's Webpage</h1>
      <p class="tagline">Hello, web-surfer! I am Gabriel and this is my webpage.</p>
    </section>
    <div class="writing-wrapper">
    <section class="writing">
      <h2>Recent Posts</h2>

      {recentPosts.length > 0 ? (
        <ul class="writing-list">
          {recentPosts.map(post => (
            <li class="writing-item">
              <a href={`/posts/${post.slug}`} class="post-title">
                {post.data.title}
              </a>
              {post.data.pubDate ? (
                <time datetime={post.data.pubDate.toISOString()} class="post-date">
                  {post.data.pubDate.toLocaleDateString('en-US', { day: 'numeric', month: 'short', year: 'numeric' })}
                </time>
              ) : (
                <span class="post-date text-muted">No date</span>
              )}
            </li>
          ))}
        </ul>
      ) : (
        <p>Writing coming soon…</p>
      )}

      <a href="/posts" class="see-all">See all posts</a>
    </section>
    </div>
  </main>
</BaseLayout>

<style>
  .hero {
    max-width: 400px;
    margin-left: auto;
    margin-right: auto;
  }

  .profile-img {
    width: 90px;
    height: 90px;
    border-radius: 50%;
    object-fit: cover;
    margin: 0 auto 1.25rem;
    display: block;
  }

  .hero h1 {
    font-size: 1.6rem;
    font-weight: 700;
    margin: 0 0 0.6rem;
    letter-spacing: -0.02em;
  }

  .tagline {
    font-size: 0.95rem;
    color: var(--text-muted);
    line-height: 1.6;
    max-width: 420px;
    margin: 0 auto;
  }

  .writing {
    margin-bottom: 5rem;
    max-width: 680px;
    margin-left: auto;
    margin-right: auto;
    padding: 0 2rem;
  }

  .writing h2 {
    font-size: 1rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-muted);
    margin-bottom: 0.5rem;
  }

  .writing-list {
    list-style: none;
    padding: 0;
    margin: 0 0 1.5rem;
    border-top: 1px solid var(--border);
  }

  .writing-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--border);
    gap: 1rem;
  }

  .post-title {
    font-size: 0.95rem;
    text-decoration: none;
    color: var(--text);
    opacity: 0.80;
    transition: opacity 0.2s ease;
    flex: 1;
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .post-title:hover {
    opacity: 1;
  }

  .post-date {
    font-size: 0.82rem;
    color: var(--text-muted);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .see-all {
    font-size: 0.88rem;
    color: var(--text-muted);
    text-decoration: none;
    display: block;
    text-align: center;
    margin-top: 1.25rem;
    transition: color 0.2s ease;
  }

  .see-all:hover {
    color: var(--text);
  }
</style>
